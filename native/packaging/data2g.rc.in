// Windows resources: icon and version block, configured per executable by
// native/CMakeLists.txt. Explorer, the taskbar and SmartScreen read these
// from the .exe; a runtime QIcon reaches none of them.

#include <winver.h>

// The first icon in the table is the executable's, so it stays first.
IDI_ICON1 ICON "@DATA2G_PACKAGING_DIR@/data2g.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0x0L
  FILEOS         VOS__WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      // Must match the signing certificate's subject once there is one
      // (and installer.nsi's Publisher). Placeholder until then.
      VALUE "CompanyName",      "Data2G"
      VALUE "FileDescription",  "Data2G HF data modem"
      VALUE "FileVersion",      "@PROJECT_VERSION@.0"
      VALUE "InternalName",     "@DATA2G_RC_NAME@"
      VALUE "OriginalFilename", "@DATA2G_RC_NAME@.exe"
      VALUE "ProductName",      "Data2G"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 0x04b0
  END
END
